[*]
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
indent_style = space

[*.targets]
indent_size = 2
[*.csproj]
indent_size = 2

[*.cs]
resharper_keep_existing_arrangement = false
resharper_keep_existing_embedded_arrangement = false
resharper_keep_existing_invocation_parens_arrangement = false
resharper_keep_existing_primary_constructor_declaration_parens_arrangement = false

resharper_wrap_lines = true

resharper_max_array_initializer_elements_on_line = 1
resharper_max_enum_members_on_line = 1
resharper_max_initializer_elements_on_line = 1

resharper_place_simple_anonymousmethod_on_single_line = false
resharper_place_single_method_argument_lambda_on_same_line = false

resharper_space_after_typecast_parentheses = true

resharper_wrap_object_and_collection_initializer_style = chop_always
resharper_wrap_property_pattern = chop_always

resharper_access_to_disposed_closure_highlighting = none

# NS1000: Non-substitutable member.
# Raised when configuring behavior, e.g. Returns(), Throws(), etc.,
# on a non-virtual class member. NSubstitute cannot intercept these calls.
dotnet_diagnostic.NS1000.severity = error

# NS1001: Non-substitutable member.
# Raised when checking received calls on a non-virtual class member,
# extension method, or other member NSubstitute cannot intercept.
dotnet_diagnostic.NS1001.severity = error

# NS1002: Non-substitutable member.
# Raised when substituting/configuring a non-virtual class member.
# Similar family as NS1000, protects against setups that look valid
# but will not be intercepted by NSubstitute.
dotnet_diagnostic.NS1002.severity = error

# NS1003: Non-substitutable member.
# Raised when substituting/configuring an internal member of a class
# while the dynamic proxy assembly does not have visibility into internals.
# Usually fixed with InternalsVisibleTo for DynamicProxyGenAssembly2,
# or by testing through an interface/public virtual member instead.
dotnet_diagnostic.NS1003.severity = error

# NS5000: Usage.
# Raised when Received(), DidNotReceive(), ReceivedWithAnyArgs(), etc.
# are used without a valid member call afterwards.
# Example bad:  sub.Received();
# Example good: sub.Received().SomeCall();
dotnet_diagnostic.NS5000.severity = error