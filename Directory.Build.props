<Project>
  <PropertyGroup Condition="'$(SolutionDir)' == ''"> <!-- Fallback for direct project build/publish where SolutionDir is not set. -->
    <SolutionDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)'))</SolutionDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <PackageReference>
      <GeneratePathProperty>true</GeneratePathProperty>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemDefinitionGroup>
</Project>
