      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="DotSpatial.Mono" Version="1.9.0">
      <GeneratePathProperty>true</GeneratePathProperty>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="DotSpatial.NetTopologySuite" Version="1.14.4">
      <GeneratePathProperty>true</GeneratePathProperty>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="DotSpatial.NTSExtension" Version="4.0.656">
