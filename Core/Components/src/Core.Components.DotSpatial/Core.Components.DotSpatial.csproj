    </PackageReference>
    <PackageReference Include="DotSpatial.Topology" Version="1.9.0">
      <GeneratePathProperty>true</GeneratePathProperty>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
