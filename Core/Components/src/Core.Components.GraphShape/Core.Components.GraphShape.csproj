<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$(SolutionDir)build\Source.targets"/>
  <ItemGroup>
    <None Include="..\..\..\..\build\Copying.Lesser.licenseheader">
      <Link>Copying.Lesser.licenseheader</Link>
    </None>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Core.Components.PointedTree\Core.Components.PointedTree.csproj"/>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="GraphShape">
      <Version>1.2.1</Version>
      <GeneratePathProperty>true</GeneratePathProperty>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="GraphShape.Controls">
      <Version>1.2.2</Version>
      <GeneratePathProperty>true</GeneratePathProperty>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="WPFExtensions">
      <Version>1.0.0</Version>
      <GeneratePathProperty>true</GeneratePathProperty>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="QuikGraph">
      <Version>2.3.0</Version>
      <GeneratePathProperty>true</GeneratePathProperty>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="xcopy /d/s/y &quot;$(PkgGraphShape)\lib\net5.0\*&quot; &quot;$(SolutionDir)bin\$(Configuration)\Application\Built-in\Managed\Third-party\GraphShape-1.2.1\*&quot;"/>
    <Exec Command="xcopy /d/s/y &quot;$(PkgGraphShape_Controls)\lib\net5.0-windows7.0\*&quot; &quot;$(SolutionDir)bin\$(Configuration)\Application\Built-in\Managed\Third-party\GraphShape.Controls-1.2.2\*&quot;" />
    <Exec Command="xcopy /d/s/y &quot;$(PkgWPFExtensions)\lib\*&quot; &quot;$(SolutionDir)bin\$(Configuration)\Application\Built-in\Managed\Third-party\WPFExtensions-1.0.0\*&quot;"/>
    <Exec Command="xcopy /d/s/y &quot;$(PkgQuikGraph)\lib\netstandard2.0\*&quot; &quot;$(SolutionDir)bin\$(Configuration)\Application\Built-in\Managed\Third-party\QuikGraph-2.3.0\*&quot;"/>
  </Target>
</Project>
