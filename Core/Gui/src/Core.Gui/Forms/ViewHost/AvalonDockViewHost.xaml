<UserControl x:Class="Core.Gui.Forms.ViewHost.AvalonDockViewHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ad="https://github.com/Dirkster99/AvalonDock"
             xmlns:viewHost="clr-namespace:Core.Gui.Forms.ViewHost"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Core.Gui;component/Style/DeltaresStyle.xaml" /> 
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ad:DockingManager x:Name="DockingManager" AllowMixedOrientation="True">
            <ad:DockingManager.Theme>
                <ad:GenericTheme/>
            </ad:DockingManager.Theme>
            <ad:DockingManager.IconContentTemplate>
                <DataTemplate d:DataContext="{d:DesignInstance viewHost:CustomLayoutDocument}">
                    <TextBlock Style="{StaticResource ButtonIconStyle}"
                               Text="{Binding Symbol}"
                               FontFamily="{Binding FontFamily}"
                               Margin="0,0,4,0"
                               FontSize="24"/>
                </DataTemplate>
            </ad:DockingManager.IconContentTemplate>
            <ad:DockingManager.DocumentPaneMenuItemHeaderTemplate>
                <DataTemplate d:DataContext="{d:DesignInstance viewHost:CustomLayoutDocument}">
                    <DockPanel>
                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </DataTemplate>
            </ad:DockingManager.DocumentPaneMenuItemHeaderTemplate>
            <ad:DockingManager.DocumentHeaderTemplate>
                <DataTemplate d:DataContext="{d:DesignInstance viewHost:CustomLayoutDocument}">
                    <DockPanel>
                        <TextBlock Style="{StaticResource ButtonIconStyle}"
                                   Text="{Binding Symbol}"
                                   FontFamily="{Binding FontFamily}"
                                   Margin="0,0,4,0"
                                   FontSize="24"/>
                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </DataTemplate>
            </ad:DockingManager.DocumentHeaderTemplate>
            <ad:DockingManager.AnchorableHeaderTemplate>
                <DataTemplate d:DataContext="{d:DesignInstance viewHost:CustomLayoutAnchorable}">
                    <DockPanel>
                        <TextBlock Style="{StaticResource ButtonIconStyle}"
                                   Text="{Binding Symbol}"
                                   FontFamily="{Binding FontFamily}"
                                   Margin="0,0,4,0"
                                   FontSize="24"/>
                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </DataTemplate>
            </ad:DockingManager.AnchorableHeaderTemplate>
            <ad:LayoutRoot>
                <ad:LayoutPanel Orientation="Horizontal" x:Name="LeftRightLayoutTarget">
                    <ad:LayoutAnchorablePaneGroup x:Name="LeftLayoutAnchorablePaneGroup" Orientation="Vertical" DockWidth="400">
                        <ad:LayoutAnchorablePane />
                    </ad:LayoutAnchorablePaneGroup>
                    <ad:LayoutPanel Orientation="Vertical" x:Name="BottomLayoutTarget">
                        <ad:LayoutDocumentPaneGroup x:Name="LayoutDocumentPaneGroup">
                        <ad:LayoutDocumentPane />
                        </ad:LayoutDocumentPaneGroup>
                        <ad:LayoutAnchorablePaneGroup>
                        <ad:LayoutAnchorablePane>
                            <ad:LayoutAnchorable x:Name="DummyPanelA"/> <!-- Don't remove: dummy panel in order to prevent garbage collection by AvalonDock -->
                        </ad:LayoutAnchorablePane>
                        </ad:LayoutAnchorablePaneGroup>
                        <ad:LayoutAnchorablePaneGroup x:Name="BottomLayoutAnchorablePaneGroup" DockHeight="200">
                            <ad:LayoutAnchorablePane />
                        </ad:LayoutAnchorablePaneGroup>
                    </ad:LayoutPanel>
                    <ad:LayoutAnchorablePaneGroup>
                        <ad:LayoutAnchorablePane>
                            <ad:LayoutAnchorable x:Name="DummyPanelB"/> <!-- Don't remove: dummy panel in order to prevent garbage collection by AvalonDock -->
                        </ad:LayoutAnchorablePane>
                    </ad:LayoutAnchorablePaneGroup>
                    <ad:LayoutAnchorablePaneGroup x:Name="RightLayoutAnchorablePaneGroup" Orientation="Vertical" DockWidth="400">
                        <ad:LayoutAnchorablePane />
                    </ad:LayoutAnchorablePaneGroup>
                </ad:LayoutPanel>
            </ad:LayoutRoot>
        </ad:DockingManager>

</UserControl>
