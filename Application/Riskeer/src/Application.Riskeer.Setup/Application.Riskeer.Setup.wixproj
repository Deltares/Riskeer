<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <!-- 
		Custom Field: ReleaseVersion
		Field is injected into WiX with the same name to make it available there as well.
	-->
    <ReleaseVersion>24.2.1.1</ReleaseVersion>
    <!--
		Environment Variable: BUILD_NUMBER
		Field could be set by BuildServer. If not present, it will be skipped.
	-->
    <OutputName>Riskeer Setup ($(ReleaseVersion))</OutputName>
    <Name>RiskeerSetup</Name>
    <RunWixToolsOutOfProc>true</RunWixToolsOutOfProc>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x86' ">
    <DefineConstants>Debug</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x86' ">
    <SuppressPdbOutput>True</SuppressPdbOutput>
    <Cultures>nl-NL</Cultures>
    <SuppressAllWarnings>True</SuppressAllWarnings>
    <Pedantic>False</Pedantic>
  </PropertyGroup>
  <ItemGroup>
