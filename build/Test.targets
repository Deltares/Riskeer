<Project>
  <PropertyGroup>
    <TestProjectType>UnitTest</TestProjectType>
    <OutputPath>$(SolutionDir)bin\$(Configuration)\Test</OutputPath>
    <RunSettingsFilePath>$(SolutionDir)bin\$(Configuration)\Test\Riskeer.runsettings</RunSettingsFilePath> <!-- Auto generated --> 
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>
  <PropertyGroup>
    <NoWarn>$(NoWarn);CA1001</NoWarn> <!-- "Types that own disposable fields should be disposable" -->
  </PropertyGroup>
  <Import Project="$(SolutionDir)build\Base.targets" />
  <Import Project="$(SolutionDir)build\NUnit.targets" />
  <ItemGroup>
    <PackageReference Include="Microsoft.ApplicationInsights"/>
    <PackageReference Include="Microsoft.CodeCoverage"/>
    <PackageReference Include="Microsoft.Extensions.DependencyModel"/>
    <PackageReference Include="Microsoft.NET.Test.Sdk"/>
    <PackageReference Include="Microsoft.Testing.Extensions.Telemetry"/>
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport.Abstractions"/>
    <PackageReference Include="Microsoft.Testing.Extensions.VSTestBridge"/>
    <PackageReference Include="Microsoft.Testing.Platform"/>
    <PackageReference Include="Microsoft.Testing.Platform.MSBuild"/>
    <PackageReference Include="Microsoft.TestPlatform.ObjectModel"/>
    <PackageReference Include="Microsoft.TestPlatform.TestHost"/>
    <PackageReference Include="NUnit3TestAdapter"/>
  </ItemGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Coverage|x64'">
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(SolutionDir)build\TestFontInitializer.cs">
      <Link>Properties\TestFontInitializer.cs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="$(SolutionDir)build\AssemblyResolverStartupHook\AssemblyResolverStartupHook.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>
  <Target Name="CopyTestData" AfterTargets="Build">
    <ItemGroup>
      <MySourceFiles Include="$(ProjectDir)test-data\**\*.*"/>
    </ItemGroup>
    <Copy SourceFiles="@(MySourceFiles)"
          DestinationFiles="@(MySourceFiles->'$(OutDir)test-data\$(ProjectName)\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"/>
  </Target>
  <Target Name="TestPostBuild" AfterTargets="PostBuildEvent">
    <ItemGroup>
      <TestHostFiles Include="$(PkgMicrosoft_TestPlatform_TestHost)\lib\net8.0\**\*"
                     Exclude="$(PkgMicrosoft_TestPlatform_TestHost)\lib\net8.0\x86\**\*;$(PkgMicrosoft_TestPlatform_TestHost)\lib\net8.0\arm64\**\*"/>
    </ItemGroup>
    <Copy SourceFiles="@(TestHostFiles)"
          DestinationFiles="@(TestHostFiles->'$(OutDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"/>
  </Target>
</Project>