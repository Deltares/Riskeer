<Project>
  <PropertyGroup>
    <TestProjectType>UnitTest</TestProjectType>
    <OutputPath>$(SolutionDir)bin\$(Configuration)\Test</OutputPath>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>
  <PropertyGroup>
    <NoWarn>$(NoWarn);CA1001</NoWarn> <!-- "Types that own disposable fields should be disposable" -->
  </PropertyGroup>
  <Import Project="$(SolutionDir)build\Base.targets" />
  <ItemGroup>
    <PackageReference Include="Microsoft.ApplicationInsights">
      <Version>2.23.0</Version>
      <GeneratePathProperty>true</GeneratePathProperty>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.CodeCoverage">
      <Version>18.8.1</Version>
      <GeneratePathProperty>true</GeneratePathProperty>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.DependencyModel">
      <Version>8.0.2</Version>
      <GeneratePathProperty>true</GeneratePathProperty>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk">
      <Version>18.8.1</Version>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Testing.Extensions.Telemetry">
      <Version>2.1.0</Version>
      <GeneratePathProperty>true</GeneratePathProperty>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport.Abstractions">
      <Version>2.1.0</Version>
      <GeneratePathProperty>true</GeneratePathProperty>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Testing.Extensions.VSTestBridge">
      <Version>2.1.0</Version>
      <GeneratePathProperty>true</GeneratePathProperty>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Testing.Platform">
      <Version>2.1.0</Version>
      <GeneratePathProperty>true</GeneratePathProperty>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Testing.Platform.MSBuild">
      <Version>2.1.0</Version>
      <GeneratePathProperty>true</GeneratePathProperty>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.TestPlatform.ObjectModel">
      <Version>18.8.1</Version>
      <GeneratePathProperty>true</GeneratePathProperty>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.TestPlatform.TestHost">
      <Version>18.8.1</Version>
      <GeneratePathProperty>true</GeneratePathProperty>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="NUnit3TestAdapter">
      <Version>6.2.0</Version>
      <GeneratePathProperty>true</GeneratePathProperty>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Coverage|x86'">
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(SolutionDir)build\AssemblyResolver.cs">
      <Link>AssemblyResolver\AssemblyResolver.cs</Link>
    </Compile>
    <Compile Include="$(SolutionDir)build\AssemblyResolverSetup.cs">
      <Link>AssemblyResolver\AssemblyResolverSetup.cs</Link>
    </Compile>
  </ItemGroup>
  <Target Name="CopyTestData" AfterTargets="Build">
    <ItemGroup>
      <MySourceFiles Include="$(ProjectDir)test-data\**\*.*"/>
    </ItemGroup>
    <Copy SourceFiles="@(MySourceFiles)"
          DestinationFiles="@(MySourceFiles->'$(OutDir)test-data\$(ProjectName)\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"/>
  </Target>
  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="xcopy /d/s/y &quot;$(PkgMicrosoft_ApplicationInsights)\lib\netstandard2.0\*&quot; &quot;$(OutDir)*&quot;"/>
    <Exec Command="xcopy /d/s/y &quot;$(PkgMicrosoft_CodeCoverage)\lib\net8.0\*&quot; &quot;$(OutDir)*&quot;"/>
    <Exec Command="xcopy /d/s/y &quot;$(PkgMicrosoft_Extensions_DependencyModel)\lib\net8.0\*&quot; &quot;$(OutDir)*&quot;"/>
    <Exec Command="xcopy /d/s/y &quot;$(PkgMicrosoft_Testing_Extensions_Telemetry)\lib\net9.0\*&quot; &quot;$(OutDir)*&quot;"/>
    <Exec Command="xcopy /d/s/y &quot;$(PkgMicrosoft_Testing_Extensions_TrxReport_Abstractions)\lib\net9.0\*&quot; &quot;$(OutDir)*&quot;"/>
    <Exec Command="xcopy /d/s/y &quot;$(PkgMicrosoft_Testing_Extensions_VSTestBridge)\lib\net9.0\*&quot; &quot;$(OutDir)*&quot;"/>
    <Exec Command="xcopy /d/s/y &quot;$(PkgMicrosoft_Testing_Platform)\lib\net9.0\*&quot; &quot;$(OutDir)*&quot;"/>
    <Exec Command="xcopy /d/s/y &quot;$(PkgMicrosoft_Testing_Platform_MSBuild)\lib\net9.0\*&quot; &quot;$(OutDir)*&quot;"/>
    <Exec Command="xcopy /d/s/y &quot;$(PkgMicrosoft_TestPlatform_ObjectModel)\lib\net8.0\*&quot; &quot;$(OutDir)*&quot;"/>
    <Exec Command="xcopy /d/s/y &quot;$(PkgMicrosoft_TestPlatform_TestHost)\lib\net8.0\*&quot; &quot;$(OutDir)*&quot;"/>
    <Exec Command="xcopy /d/s/y &quot;$(PkgNUnit3TestAdapter)\build\net8.0\*&quot; &quot;$(OutDir)*&quot;"/>
  </Target>
</Project>