<Project>
  <Import Project="$(SolutionDir)build\Base.targets" />
  <Target Name="PostBuildCopyAssembly" AfterTargets="PostBuildEvent">
    <ItemGroup>
      <_CoreAssemblyFile Include="$(OutDir)$(AssemblyName).dll"/>
      <_CoreAssemblyFile Include="$(OutDir)$(AssemblyName).pdb" Condition="$(DefineConstants.Contains('DEBUG')) Or $(DefineConstants.Contains('COVERAGE'))"/>
    </ItemGroup>
    <!-- Retries replace the former endless "xcopy ... if ErrorLevel 1 goto loop" for transiently locked files. -->
    <Copy SourceFiles="@(_CoreAssemblyFile)"
          DestinationFolder="$(BuiltInManagedOutputDir)Core\"
          SkipUnchangedFiles="true"
          Retries="10"
          RetryDelayMilliseconds="1000"/>
  </Target>
</Project>