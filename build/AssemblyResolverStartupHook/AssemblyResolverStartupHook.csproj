<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Deliberately standalone: this assembly is loaded by the runtime through DOTNET_STARTUP_HOOKS before the
    entry assembly, so it must not pull in any dependency that would require the very resolution it installs.
    For that reason Base.targets is not imported (no WPF/WinForms, no shared package references).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Platforms>x86</Platforms>
    <PlatformTarget>x86</PlatformTarget>
    <Configurations>Debug;Release;Coverage</Configurations>
    <AssemblyName>AssemblyResolverStartupHook</AssemblyName>
    <RootNamespace>AssemblyResolverStartupHook</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>$(MSBuildThisFileDirectory)..\..\bin\$(Configuration)\Test\</OutputPath>
    <OutDir>$(OutputPath)</OutDir>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>TRACE;DEBUG</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE;RELEASE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Coverage'">
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE;COVERAGE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\AssemblyResolver.cs">
      <Link>AssemblyResolver.cs</Link>
    </Compile>
    <Compile Include="..\AssemblyResolverInstaller.cs">
      <Link>AssemblyResolverInstaller.cs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <None Include="..\Copying.licenseheader">
      <Link>Copying.licenseheader</Link>
    </None>
  </ItemGroup>
  <!--
    DOTNET_STARTUP_HOOKS only accepts absolute paths, so the run settings pointing at this assembly cannot be
    checked in and are generated next to the test assemblies instead.
  -->
  <Target Name="GenerateRiskeerRunSettings" AfterTargets="Build">
    <PropertyGroup>
      <RiskeerStartupHookPath>$([System.IO.Path]::GetFullPath('$(OutDir)$(AssemblyName).dll'))</RiskeerStartupHookPath>
      <RiskeerRunSettingsPath>$([System.IO.Path]::GetFullPath('$(OutDir)Riskeer.runsettings'))</RiskeerRunSettingsPath>
    </PropertyGroup>
    <ItemGroup>
      <!-- '?' and ';' must be escaped: the first is an Include wildcard, the second an item separator. -->
      <RiskeerRunSettingsLine Include="&lt;%3Fxml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;%3F&gt;" />
      <RiskeerRunSettingsLine Include="&lt;!-- Generated by $(MSBuildThisFileName)$(MSBuildThisFileExtension). Do not edit%3B changes are overwritten on build. --&gt;" />
      <RiskeerRunSettingsLine Include="&lt;RunSettings&gt;" />
      <RiskeerRunSettingsLine Include="%20%20&lt;RunConfiguration&gt;" />
      <RiskeerRunSettingsLine Include="%20%20%20%20&lt;EnvironmentVariables&gt;" />
      <RiskeerRunSettingsLine Include="%20%20%20%20%20%20&lt;DOTNET_STARTUP_HOOKS&gt;$(RiskeerStartupHookPath)&lt;/DOTNET_STARTUP_HOOKS&gt;" />
      <RiskeerRunSettingsLine Include="%20%20%20%20&lt;/EnvironmentVariables&gt;" />
      <RiskeerRunSettingsLine Include="%20%20&lt;/RunConfiguration&gt;" />
      <RiskeerRunSettingsLine Include="&lt;/RunSettings&gt;" />
    </ItemGroup>
    <WriteLinesToFile File="$(RiskeerRunSettingsPath)"
                      Lines="@(RiskeerRunSettingsLine)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
  </Target>
</Project>
