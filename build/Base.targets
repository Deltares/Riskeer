<Project>
  <PropertyGroup>
    <OutputPath Condition="$(OutputPath) == ''">bin\$(Configuration)\</OutputPath>
    <OutDir>$(OutputPath)</OutDir>
    <Platforms>x86</Platforms>
    <PlatformTarget>x86</PlatformTarget>
    <CodeAnalysisRuleSet>MinimumRecommendedRules.ruleset</CodeAnalysisRuleSet>
    <TargetFramework>net481</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <FileAlignment>512</FileAlignment>
    <Company>Deltares</Company>
    <Copyright>Copyright © Stichting Deltares and State of the Netherlands 2026</Copyright>
    <Version>26.1.1</Version>
    <Configurations>Debug;Release;Coverage</Configurations>
    <UseWpf>true</UseWpf>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|x86'">
    <ConfigurationGroup>Debug</ConfigurationGroup>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>TRACE;DEBUG</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|x86'">
    <ConfigurationGroup>Release</ConfigurationGroup>
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE;RELEASE</DefineConstants>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Coverage|x86'">
    <ConfigurationGroup>Release</ConfigurationGroup>
    <DefineConstants>TRACE;COVERAGE</DefineConstants>
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MSBuildConfigurationDefaults" Version="1.0.1" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Bcl.HashCode">
      <Version>6.0.0</Version>
      <GeneratePathProperty>true</GeneratePathProperty>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="System.Buffers">
      <Version>4.6.1</Version>
      <GeneratePathProperty>true</GeneratePathProperty>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="System.Collections.Immutable">
      <Version>10.0.5</Version>
      <GeneratePathProperty>true</GeneratePathProperty>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="System.Formats.Nrbf">
      <Version>10.0.5</Version>
      <GeneratePathProperty>true</GeneratePathProperty>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="System.Memory">
      <Version>4.6.3</Version>
      <GeneratePathProperty>true</GeneratePathProperty>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="System.Numerics.Vectors">
      <Version>4.6.1</Version>
      <GeneratePathProperty>true</GeneratePathProperty>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="System.Reflection.Metadata">
      <Version>10.0.5</Version>
      <GeneratePathProperty>true</GeneratePathProperty>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="System.Resources.Extensions">
      <Version>10.0.5</Version>
      <GeneratePathProperty>true</GeneratePathProperty>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe">
      <Version>6.1.2</Version>
      <GeneratePathProperty>true</GeneratePathProperty>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="System.ValueTuple">
      <Version>4.6.1</Version>
      <GeneratePathProperty>true</GeneratePathProperty>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="$(SolutionDir)build\GlobalAssembly.cs">
      <Link>Properties\GlobalAssembly.cs</Link>
    </Compile>
  </ItemGroup>
  <Target Name="BasePostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="xcopy /d/s/y &quot;$(PkgMicrosoft_Bcl_HashCode)\lib\net462\*&quot; &quot;$(OutDir)Application\Built-in\Managed\Third-party\Microsoft.Bcl.HashCode-6.0.0\*&quot;" />
    <Exec Command="xcopy /d/s/y &quot;$(PkgSystem_Buffers)\lib\net462\*&quot; &quot;$(OutDir)Application\Built-in\Managed\Third-party\System.Buffers-4.6.1\*&quot;" />
    <Exec Command="xcopy /d/s/y &quot;$(PkgSystem_Collections_Immutable)\lib\net462\*&quot; &quot;$(OutDir)Application\Built-in\Managed\Third-party\System.Collections.Immutable-10.0.5\*&quot;" />
    <Exec Command="xcopy /d/s/y &quot;$(PkgSystem_Formats_Nrbf)\lib\net462\*&quot; &quot;$(OutDir)Application\Built-in\Managed\Third-party\System.Formats.Nrbf-10.0.5\*&quot;" />
    <Exec Command="xcopy /d/s/y &quot;$(PkgSystem_Memory)\lib\net462\*&quot; &quot;$(OutDir)Application\Built-in\Managed\Third-party\System.Memory-4.6.3\*&quot;" />
    <Exec Command="xcopy /d/s/y &quot;$(PkgSystem_Numerics_Vectors)\lib\net462\*&quot; &quot;$(OutDir)Application\Built-in\Managed\Third-party\System.Numerics.Vectors-4.6.1\*&quot;" />
    <Exec Command="xcopy /d/s/y &quot;$(PkgSystem_Reflection_Metadata)\lib\net462\*&quot; &quot;$(OutDir)Application\Built-in\Managed\Third-party\System.Reflection.Metadata-10.0.5\*&quot;" />
    <Exec Command="xcopy /d/s/y &quot;$(PkgSystem_Resources_Extensions)\lib\net462\*&quot; &quot;$(OutDir)Application\Built-in\Managed\Third-party\System.Resources.Extensions-10.0.5\*&quot;" />
    <Exec Command="xcopy /d/s/y &quot;$(PkgSystem_Runtime_CompilerServices_Unsafe)\lib\net462\*&quot; &quot;$(OutDir)Application\Built-in\Managed\Third-party\System.Runtime.CompilerServices.Unsafe-6.1.2\*&quot;" />
    <Exec Command="xcopy /d/s/y &quot;$(PkgSystem_ValueTuple)\lib\net462\*&quot; &quot;$(OutDir)Application\Built-in\Managed\Third-party\System.ValueTuple-4.6.1\*&quot;" />
  </Target>
</Project>