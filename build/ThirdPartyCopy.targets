<Project>
  <!--
    Copies third-party (and other prebuilt) files into the application or test output folders, replacing
    the former per-project "xcopy /d/s/y" post-build steps. Imported by Base.targets; it does nothing for
    projects that do not opt in.

    Every entry ends up in a destination folder, determined as follows:
      - ThirdPartyDestination metadata (a full folder path), when set; otherwise
      - $(ThirdPartyOutputDir)<ThirdPartyFolder>\, where ThirdPartyFolder may contain sub folders
        (e.g. "System.Data.SQLite-1.0.119\x64").

    Three ways to opt in:

    1. A package: reference it by name in the project (<PackageReference Include="MahApps.Metro"/>). What is copied
       is defined once, centrally, on its PackageVersion in Directory.Packages.props:

         <PackageVersion Include="MahApps.Metro" Version="2.4.11" ThirdPartySource="$(PkgMahApps_Metro)\lib\net47"/>

       ThirdPartyFolder defaults to "<Id>-<Version>". ThirdPartyInclude defaults to **\*.dll, so documentation
       (.xml), symbols (.pdb) and MSBuild files from the package are not copied. A second folder of a package goes
       in a ThirdPartyPackageContent item named after the package, also in Directory.Packages.props; it is copied
       only by projects that reference the package.

    2. A folder in the repository (e.g. under lib\): a ThirdPartyDirectory item. Its contents are collected recursively
       at build time. ThirdPartyInclude defaults to **\* here, because these folders hold exactly what must be shipped.

         <ThirdPartyDirectory Include="$(SolutionDir)lib\HydraRing">
           <ThirdPartyDestination>...</ThirdPartyDestination>
         </ThirdPartyDirectory>

    3. Individual files in the repository: ThirdPartyFile items. With a wildcard Include, the
       %(RecursiveDir) structure is kept.

    A missing source folder fails the build: that usually means a package or target framework changed,
    and silently copying nothing would only surface at runtime.

    NOTE: AssemblyResolver throws on duplicate assemblies under Built-in\Managed, so every project that
    copies a given package must use the same destination folder.
  -->
  <PropertyGroup>
    <BuiltInManagedOutputDir Condition="'$(BuiltInManagedOutputDir)' == ''">$(SolutionDir)bin\$(Configuration)\Application\Built-in\Managed\</BuiltInManagedOutputDir>
    <ThirdPartyOutputDir Condition="'$(ThirdPartyOutputDir)' == ''">$(BuiltInManagedOutputDir)Third-party\</ThirdPartyOutputDir>
    <ThirdPartyPackageInclude Condition="'$(ThirdPartyPackageInclude)' == ''">**\*.dll</ThirdPartyPackageInclude>
  </PropertyGroup>

  <Target Name="CopyThirdPartyFiles" AfterTargets="PostBuildEvent">
    <ItemGroup>
      <!-- Central package definitions (Directory.Packages.props), limited to the packages this project references. -->
      <_ThirdPartyUnreferencedPackage Include="@(PackageVersion);@(ThirdPartyPackageContent)" Exclude="@(PackageReference)"/>
      <_ThirdPartyReferencedPackage Include="@(PackageVersion);@(ThirdPartyPackageContent)" Exclude="@(_ThirdPartyUnreferencedPackage)"/>

      <!-- Packages and directories are both "source folders". -->
      <_ThirdPartySourceDirectory Include="@(_ThirdPartyReferencedPackage->'%(ThirdPartySource)')" Condition="'%(_ThirdPartyReferencedPackage.ThirdPartySource)' != ''">
        <_Owner>package '%(_ThirdPartyReferencedPackage.Identity)'</_Owner>
        <_DefaultFolder>%(_ThirdPartyReferencedPackage.Identity)-%(_ThirdPartyReferencedPackage.Version)</_DefaultFolder>
        <_DefaultInclude>$(ThirdPartyPackageInclude)</_DefaultInclude>
      </_ThirdPartySourceDirectory>
      <_ThirdPartySourceDirectory Include="@(ThirdPartyDirectory)">
        <_Owner>ThirdPartyDirectory</_Owner>
        <_DefaultInclude>**\*</_DefaultInclude>
      </_ThirdPartySourceDirectory>
    </ItemGroup>

    <Error Condition="'@(_ThirdPartySourceDirectory)' != '' And !Exists('%(_ThirdPartySourceDirectory.FullPath)')"
           Text="Third-party source folder '%(_ThirdPartySourceDirectory.Identity)' of %(_ThirdPartySourceDirectory._Owner) does not exist."/>
    <Error Condition="'@(_ThirdPartySourceDirectory)' != '' And '%(_ThirdPartySourceDirectory.ThirdPartyDestination)%(_ThirdPartySourceDirectory.ThirdPartyFolder)%(_ThirdPartySourceDirectory._DefaultFolder)' == ''"
           Text="ThirdPartyDirectory '%(_ThirdPartySourceDirectory.Identity)' needs ThirdPartyFolder or ThirdPartyDestination metadata."/>
    <Error Condition="'@(ThirdPartyFile)' != '' And '%(ThirdPartyFile.ThirdPartyDestination)%(ThirdPartyFile.ThirdPartyFolder)' == ''"
           Text="ThirdPartyFile '%(ThirdPartyFile.Identity)' needs ThirdPartyFolder or ThirdPartyDestination metadata."/>

    <ItemGroup>
      <_ThirdPartySourceDirectory Condition="'%(_ThirdPartySourceDirectory.ThirdPartyFolder)' == ''">
        <ThirdPartyFolder>%(_ThirdPartySourceDirectory._DefaultFolder)</ThirdPartyFolder>
      </_ThirdPartySourceDirectory>
      <_ThirdPartySourceDirectory Condition="'%(_ThirdPartySourceDirectory.ThirdPartyInclude)' == ''">
        <ThirdPartyInclude>%(_ThirdPartySourceDirectory._DefaultInclude)</ThirdPartyInclude>
      </_ThirdPartySourceDirectory>

      <!-- The condition matters: with no source folders, this would still run once with an empty path and glob the project folder. -->
      <_ThirdPartyFile Include="$([MSBuild]::EnsureTrailingSlash('%(_ThirdPartySourceDirectory.FullPath)'))%(_ThirdPartySourceDirectory.ThirdPartyInclude)" Condition="'@(_ThirdPartySourceDirectory)' != ''">
        <ThirdPartyFolder>%(_ThirdPartySourceDirectory.ThirdPartyFolder)</ThirdPartyFolder>
        <ThirdPartyDestination>%(_ThirdPartySourceDirectory.ThirdPartyDestination)</ThirdPartyDestination>
      </_ThirdPartyFile>
      <_ThirdPartyFile Include="@(ThirdPartyFile)"/>

      <_ThirdPartyFile Condition="'%(_ThirdPartyFile.ThirdPartyDestination)' == ''">
        <ThirdPartyDestination>$(ThirdPartyOutputDir)%(_ThirdPartyFile.ThirdPartyFolder)</ThirdPartyDestination>
      </_ThirdPartyFile>
      <_ThirdPartyFile>
        <_Destination>$([MSBuild]::EnsureTrailingSlash('%(_ThirdPartyFile.ThirdPartyDestination)'))%(_ThirdPartyFile.RecursiveDir)%(_ThirdPartyFile.Filename)%(_ThirdPartyFile.Extension)</_Destination>
      </_ThirdPartyFile>
    </ItemGroup>

    <Copy SourceFiles="@(_ThirdPartyFile)"
          DestinationFiles="@(_ThirdPartyFile->'%(_Destination)')"
          SkipUnchangedFiles="true"/>
  </Target>
</Project>
